# Copy this file to .env and fill in your values.
# git-booster reads these from the environment (not from .env automatically).
# Add: source .env  in your shell profile, or use direnv.

# Optional: Override the Ollama server URL (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Optional: Override the default model (default: llama3.2)
# Recommended for code tasks on a GTX 1050 Ti (4GB VRAM):
GAI_MODEL=qwen2.5-coder:3b
