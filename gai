#!/usr/bin/env zsh
# gai — git-booster wrapper
# Fully automated: creates .venv, installs Ollama, pulls model, starts server.
# Zero manual steps required.

SCRIPT_DIR="${0:A:h}"
VENV="$SCRIPT_DIR/.venv"
CONFIG_FILE="$HOME/.config/git-booster/config.env"
DEFAULT_MODEL="qwen2.5-coder:3b"
OLLAMA_HOST_DEFAULT="http://localhost:11434"

# ── Load saved config ─────────────────────────────────────────────────────────
[[ -f "$CONFIG_FILE" ]] && { set -a; source "$CONFIG_FILE"; set +a; }
[[ -f "$SCRIPT_DIR/.env" ]] && { set -a; source "$SCRIPT_DIR/.env"; set +a; }

GAI_MODEL="${GAI_MODEL:-$DEFAULT_MODEL}"
OLLAMA_HOST="${OLLAMA_HOST:-$OLLAMA_HOST_DEFAULT}"

# ── 1. Create .venv if missing ────────────────────────────────────────────────
if [[ ! -f "$VENV/bin/activate" ]]; then
    echo "[git-booster] Creating virtual environment..."
    python3 -m venv "$VENV" || { echo "[git-booster] ERROR: python3 not found."; exit 1; }
    echo "[git-booster] Installing git-booster..."
    "$VENV/bin/pip" install -q -e "$SCRIPT_DIR"
    echo "[git-booster] Done."
fi

source "$VENV/bin/activate"

# ── 2. Install Ollama if missing ──────────────────────────────────────────────
if ! command -v ollama &>/dev/null; then
    echo "[git-booster] Ollama not found — installing..."
    curl -fsSL https://ollama.com/install.sh | sh
    if ! command -v ollama &>/dev/null; then
        echo "[git-booster] ERROR: Ollama installation failed."
        exit 1
    fi
    echo "[git-booster] Ollama installed."
fi

# ── 3. Start ollama serve if not running ──────────────────────────────────────
_ollama_alive() {
    curl -sf "${OLLAMA_HOST}/api/tags" -o /dev/null 2>/dev/null
}

if ! _ollama_alive; then
    echo "[git-booster] Starting Ollama server..."
    ollama serve &>/tmp/ollama.log &
    OLLAMA_PID=$!
    # Wait up to 8s for server to be ready
    for i in {1..8}; do
        sleep 1
        _ollama_alive && break
        if [[ $i -eq 8 ]]; then
            echo "[git-booster] ERROR: Ollama server did not start."
            echo "Check /tmp/ollama.log for details."
            exit 1
        fi
    done
    echo "[git-booster] Ollama ready."
fi

# ── 4. Pull model if not installed ────────────────────────────────────────────
_model_installed() {
    curl -sf "${OLLAMA_HOST}/api/tags" 2>/dev/null \
        | python3 -c "import sys,json; d=json.load(sys.stdin); print(any(m['name']==sys.argv[1] for m in d.get('models',[])))" "$GAI_MODEL" 2>/dev/null
}

if [[ "$(_model_installed)" != "True" ]]; then
    echo "[git-booster] Pulling model $GAI_MODEL (first run — may take a few minutes)..."
    ollama pull "$GAI_MODEL"
    echo "[git-booster] Model $GAI_MODEL ready."
fi

# ── 5. Show active config (transparency) ──────────────────────────────────────
echo ""
echo "[ git-booster ] model: $GAI_MODEL | host: $OLLAMA_HOST"
echo ""

# ── 6. Run gai ────────────────────────────────────────────────────────────────
exec "$VENV/bin/gai" "$@"
