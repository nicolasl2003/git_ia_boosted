# Copy this file to .env and fill in your values.
# git-booster reads these from the environment (not from .env automatically).
# Add: source .env  in your shell profile, or use direnv.

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override the default model (claude-3-5-haiku-20241022)
# GIT_BOOSTER_MODEL=claude-opus-4-5
